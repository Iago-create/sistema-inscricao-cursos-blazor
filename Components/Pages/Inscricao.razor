@page "/inscricao"
@rendermode InteractiveServer
@using SistemaInscricaoCursosBlazor.Components.Models

<PageTitle>Inscrição em Cursos</PageTitle>

<h1>Inscrição em Cursos</h1>

@if (sucesso)
{
    <div class="alert alert-success" role="alert">
        Inscrição confirmada com sucesso, @modelo.Nome!
    </div>
}

<EditForm Model="modelo" FormName="InscricaoForm" OnValidSubmit="EnviarAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="nome" class="form-label">Nome</label>
        <InputText id="nome" class="form-control" @bind-Value="modelo.Nome" />
        <ValidationMessage For="() => modelo.Nome" />
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">E-mail</label>
        <InputText id="email" class="form-control" @bind-Value="modelo.Email" />
        <ValidationMessage For="() => modelo.Email" />
    </div>

    <div class="mb-3">
        <label for="idade" class="form-label">Idade</label>
        <InputNumber id="idade" class="form-control" @bind-Value="modelo.Idade" />
        <ValidationMessage For="() => modelo.Idade" />
    </div>

    <div class="mb-3">
        <label for="curso" class="form-label">Curso</label>
        <InputSelect id="curso" class="form-select" @bind-Value="modelo.CursoId">
            <option value="">Selecione um curso...</option>
            <option value="dotnet">Desenvolvimento .NET</option>
            <option value="web">Desenvolvimento Web com Blazor</option>
            <option value="ux">UX e Usabilidade</option>
            <option value="redes">Redes e Sistemas de Comunicação</option>
        </InputSelect>
        <ValidationMessage For="() => modelo.CursoId" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@enviando">
        @(enviando ? "Processando..." : "Confirmar Inscrição")
    </button>
</EditForm>

@code {
    // Passo 2: propriedade pública vinculada aos dados do formulário
    [SupplyParameterFromForm]
    public InscricaoModel modelo { get; set; } = new();

    // Passo 3: variáveis de controle de estado
    private bool enviando = false;
    private bool sucesso = false;

    // Só é chamado quando todas as validações passam (OnValidSubmit)
    private async Task EnviarAsync()
    {
        enviando = true;
        sucesso = false;

        // Simula uma requisição assíncrona (ex.: chamada a uma API)
        await Task.Delay(2000);

        enviando = false;
        sucesso = true;
    }
}